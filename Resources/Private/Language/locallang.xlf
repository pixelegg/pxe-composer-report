<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="en" datatype="plaintext" original="EXT:pxe_composer_report/Resources/Private/Language/locallang.xlf" date="2026-10-28T00:00:00Z" product-name="pxe_composer_report">
    <header/>
    <body>
      <!-- Module -->
      <trans-unit id="mod.title"><source>Composer Report</source></trans-unit>
      <trans-unit id="mod.checkedAt"><source>Last run</source></trans-unit>
      <trans-unit id="mod.collector"><source>Collector</source></trans-unit>
      <trans-unit id="mod.triggeredBy"><source>Triggered by</source></trans-unit>
      <trans-unit id="trigger.cli"><source>CLI command</source></trans-unit>
      <trans-unit id="trigger.manual"><source>Manually in the backend</source></trans-unit>
      <trans-unit id="trigger.scheduler"><source>Scheduler task</source></trans-unit>
      <trans-unit id="mod.refresh"><source>Refresh now</source></trans-unit>
      <trans-unit id="mod.refreshHint"><source>Runs composer outdated and composer audit now. This can take a minute.</source></trans-unit>
      <trans-unit id="mod.testMail"><source>Send test mail</source></trans-unit>
      <trans-unit id="mod.testMailTitle"><source>Send test mail</source></trans-unit>
      <trans-unit id="mod.testMailHint"><source>Sends the current report to one address. Leave empty to use the configured recipients:</source></trans-unit>
      <trans-unit id="mod.testMailNoRecipients"><source>no recipients configured</source></trans-unit>
      <trans-unit id="mod.email"><source>Email address</source></trans-unit>
      <trans-unit id="mod.cancel"><source>Cancel</source></trans-unit>
      <trans-unit id="mod.send"><source>Send</source></trans-unit>
      <trans-unit id="mod.outdated"><source>outdated</source></trans-unit>
      <trans-unit id="mod.security"><source>security</source></trans-unit>
      <trans-unit id="mod.major"><source>major</source></trans-unit>
      <trans-unit id="mod.minor"><source>minor</source></trans-unit>
      <trans-unit id="mod.patch"><source>patch</source></trans-unit>
      <trans-unit id="mod.nextMajorAvailable"><source>newer major available</source></trans-unit>
      <trans-unit id="mod.private"><source>private, not checked</source></trans-unit>
      <trans-unit id="mod.trend"><source>Trend of outdated packages over the last runs</source></trans-unit>
      <trans-unit id="mod.trendPoint"><source>%1$s: %2$d outdated</source></trans-unit>
      <trans-unit id="mod.trendError"><source>%1$s: run failed</source></trans-unit>
      <trans-unit id="mod.trendLabel"><source>Trend</source></trans-unit>
      <trans-unit id="mod.summary"><source>Summary</source></trans-unit>
      <trans-unit id="mod.summaryHint"><source>Generated by the Anthropic API from counts and package names, see the extension documentation.</source></trans-unit>
      <trans-unit id="mod.securityHeading"><source>Security advisories</source></trans-unit>
      <trans-unit id="mod.typo3Heading"><source>TYPO3 packages</source></trans-unit>
      <trans-unit id="mod.otherHeading"><source>Other packages</source></trans-unit>
      <trans-unit id="mod.majorOnlyHeading"><source>Newer major available</source></trans-unit>
      <trans-unit id="mod.majorOnlyHint"><source>These packages are up to date within their installed major; a newer major exists. Not counted as outdated.</source></trans-unit>
      <trans-unit id="mod.privateHeading"><source>Private packages</source></trans-unit>
      <trans-unit id="mod.privateHint"><source>These direct dependencies belong to vendors listed in "privateVendors" and were not sent to Packagist. Check them with composer on the server.</source></trans-unit>
      <trans-unit id="mod.package"><source>Package</source></trans-unit>
      <trans-unit id="mod.installed"><source>Installed</source></trans-unit>
      <trans-unit id="mod.latest"><source>Latest (within major)</source></trans-unit>
      <trans-unit id="mod.impact"><source>Impact</source></trans-unit>
      <trans-unit id="mod.severity"><source>Severity</source></trans-unit>
      <trans-unit id="mod.sortBySeverity"><source>Sort by severity</source></trans-unit>
      <trans-unit id="mod.cve"><source>CVE</source></trans-unit>
      <trans-unit id="mod.advisory"><source>Advisory</source></trans-unit>
      <trans-unit id="mod.majorPrefix"><source>Major</source></trans-unit>
      <trans-unit id="mod.abandoned"><source>abandoned</source></trans-unit>
      <trans-unit id="mod.abandonedReplacement"><source>abandoned, use %s</source></trans-unit>
      <trans-unit id="mod.latestHint"><source>"Latest" is the newest stable version within the installed major. A newer major is shown as a hint only.</source></trans-unit>
      <trans-unit id="mod.allUpToDate"><source>All direct dependencies are up to date within their major version and no security advisories are known.</source></trans-unit>
      <trans-unit id="mod.emptyTitle"><source>No report yet</source></trans-unit>
      <trans-unit id="mod.emptyText"><source>Click "Refresh now", add the scheduler task "Composer update report (read-only)" or run "vendor/bin/typo3 pxe:composer-report:run".</source></trans-unit>
      <trans-unit id="mod.footer"><source>pxe_composer_report · pixelegg.de</source></trans-unit>
      <trans-unit id="mod.lastRunFailed"><source>The last run failed</source></trans-unit>
      <trans-unit id="mod.details"><source>Details</source></trans-unit>
      <trans-unit id="mod.notice"><source>Notice</source></trans-unit>

      <!-- Error codes (CollectorException::reason, ComposerReportService::ERROR_*) -->
      <trans-unit id="error.classic_mode"><source>This TYPO3 installation is not managed by composer. The report needs composer.json and composer.lock in the project root.</source></trans-unit>
      <trans-unit id="error.lock_missing"><source>composer.lock not found in the project root. Run "composer install" or "composer update" on the server first.</source></trans-unit>
      <trans-unit id="error.proc_open_disabled"><source>proc_open() is disabled for PHP (disable_functions), so composer cannot be executed. Set collectorMode to "packagist" or enable proc_open.</source></trans-unit>
      <trans-unit id="error.binary_not_found"><source>The composer binary was not found. Set "composerBinary" in the extension configuration to the full path (e.g. /usr/local/bin/composer or /path/composer.phar) or set collectorMode to "packagist".</source></trans-unit>
      <trans-unit id="error.composer_failed"><source>composer exited with an error.</source></trans-unit>
      <trans-unit id="error.packagist_disabled"><source>The Packagist collector is in use, but "resolveLatestViaPackagist" is disabled. Either allow Packagist lookups or make the composer binary available.</source></trans-unit>
      <trans-unit id="error.packagist_failed"><source>Packagist could not be reached.</source></trans-unit>
      <trans-unit id="error.unexpected"><source>Unexpected error, see the TYPO3 log.</source></trans-unit>

      <!-- Notices (CollectorFactory::NOTICE_*) -->
      <trans-unit id="notice.fallback_no_proc_open"><source>proc_open() is disabled for PHP, so the Packagist collector was used instead of composer. Private packages are not checked.</source></trans-unit>
      <trans-unit id="notice.fallback_no_binary"><source>The composer binary was not found in the PATH of the PHP process, so the Packagist collector was used. Set "composerBinary" in the extension configuration to use composer.</source></trans-unit>

      <!-- Flash messages -->
      <trans-unit id="flash.refreshed"><source>Report updated: %1$d outdated packages, %2$d security advisories.</source></trans-unit>
      <trans-unit id="flash.invalidEmail"><source>Invalid email address: %s</source></trans-unit>
      <trans-unit id="flash.noReportForMail"><source>There is no report to send yet. Run "Refresh now" first.</source></trans-unit>
      <trans-unit id="flash.mailSent"><source>Test mail sent to %s.</source></trans-unit>
      <trans-unit id="flash.mailFailed"><source>The test mail could not be sent. Enter an address or configure recipients in the extension configuration, and check the TYPO3 log.</source></trans-unit>
      <trans-unit id="flash.configuredRecipients"><source>the configured recipients</source></trans-unit>

      <!-- Email -->
      <trans-unit id="email.subject"><source>Composer report: %1$s (%2$d outdated, %3$d security)</source></trans-unit>
      <trans-unit id="email.dateFormat"><source>Y-m-d H:i</source></trans-unit>
      <trans-unit id="email.eyebrow"><source>Composer Report</source></trans-unit>
      <trans-unit id="email.title"><source>Composer report</source></trans-unit>
      <trans-unit id="email.checkedAt"><source>Checked on</source></trans-unit>
      <trans-unit id="email.collector"><source>Collector</source></trans-unit>
      <trans-unit id="email.summary"><source>Summary</source></trans-unit>
      <trans-unit id="email.outdated"><source>outdated</source></trans-unit>
      <trans-unit id="email.security"><source>security</source></trans-unit>
      <trans-unit id="email.major"><source>major</source></trans-unit>
      <trans-unit id="email.minor"><source>minor</source></trans-unit>
      <trans-unit id="email.patch"><source>patch</source></trans-unit>
      <trans-unit id="email.nextMajorAvailable"><source>newer major available</source></trans-unit>
      <trans-unit id="email.latestHint"><source>"Latest" is the newest stable version within the installed major. A newer major is shown as a hint only.</source></trans-unit>
      <trans-unit id="email.securityHeading"><source>Security advisories</source></trans-unit>
      <trans-unit id="email.typo3Heading"><source>TYPO3 packages</source></trans-unit>
      <trans-unit id="email.otherHeading"><source>Other packages</source></trans-unit>
      <trans-unit id="email.majorOnlyHeading"><source>Newer major available</source></trans-unit>
      <trans-unit id="email.majorOnlyHint"><source>Up to date within the installed major; a newer major exists. Not counted as outdated.</source></trans-unit>
      <trans-unit id="email.privateHeading"><source>Private packages (not checked)</source></trans-unit>
      <trans-unit id="email.privateHint"><source>These packages belong to vendors marked as private and were not sent to Packagist.</source></trans-unit>
      <trans-unit id="email.abandoned"><source>abandoned</source></trans-unit>
      <trans-unit id="email.majorPrefix"><source>Major</source></trans-unit>
      <trans-unit id="email.nothingOutdated"><source>All direct dependencies are up to date within their major version and no security advisories are known.</source></trans-unit>
      <trans-unit id="email.footer"><source>pxe_composer_report · pixelegg.de · read-only</source></trans-unit>

      <!-- Scheduler task -->
      <trans-unit id="task.title"><source>Composer update report (read-only)</source></trans-unit>
      <trans-unit id="task.description"><source>Runs composer outdated and composer audit (read-only), stores the report and emails it when configured. Extension pxe_composer_report.</source></trans-unit>

      <!-- Extension configuration (label: "Title: description") -->
      <trans-unit id="conf.category.privacy"><source>Privacy</source></trans-unit>
      <trans-unit id="conf.category.email"><source>Email</source></trans-unit>
      <trans-unit id="conf.category.ai"><source>AI summary</source></trans-unit>
      <trans-unit id="conf.subcategory.collector"><source>Data collection</source></trans-unit>
      <trans-unit id="conf.subcategory.report"><source>Report and history</source></trans-unit>
      <trans-unit id="conf.subcategory.lookups"><source>External lookups</source></trans-unit>
      <trans-unit id="conf.subcategory.delivery"><source>Delivery</source></trans-unit>
      <trans-unit id="conf.subcategory.anthropic"><source>Anthropic API</source></trans-unit>
      <trans-unit id="conf.collectorMode"><source>Collector: How to detect outdated packages. auto = composer when proc_open and the binary are available, otherwise the Packagist API.</source></trans-unit>
      <trans-unit id="conf.composerBinary"><source>Composer binary: "composer" (searched in the PATH of the PHP process) or a full path such as /usr/local/bin/composer or /opt/composer.phar.</source></trans-unit>
      <trans-unit id="conf.projectLabel"><source>Project label: Name shown in the module and the email. Defaults to the site name.</source></trans-unit>
      <trans-unit id="conf.keepRuns"><source>Keep runs: Number of stored runs; older ones are deleted after each run. 0 keeps everything.</source></trans-unit>
      <trans-unit id="conf.resolveLatestViaPackagist"><source>Allow Packagist lookups: When disabled, the extension itself never contacts packagist.org (the composer collector then works without any lookup of its own, the Packagist collector stops with an error).</source></trans-unit>
      <trans-unit id="conf.privateVendors"><source>Private vendors: Comma-separated vendor prefixes or package names (e.g. "acme, mycorp/intranet"). Never sent to Packagist, the advisories API or the AI summary.</source></trans-unit>
      <trans-unit id="conf.emailEnabled"><source>Send email report: Email the report after each scheduled or CLI run.</source></trans-unit>
      <trans-unit id="conf.emailRecipients"><source>Email recipients: Comma-separated addresses.</source></trans-unit>
      <trans-unit id="conf.emailOnlyOnFindings"><source>Only email on findings: Skip the email when nothing is outdated and no advisory exists.</source></trans-unit>
      <trans-unit id="conf.emailLanguage"><source>Email language: Language of the report email and of the AI summary.</source></trans-unit>
      <trans-unit id="conf.aiEnabled"><source>AI summary: Generate a short plain-language summary with the Anthropic API (sends counts and package names, see the documentation).</source></trans-unit>
      <trans-unit id="conf.anthropicApiKey"><source>Anthropic API key: Required for the AI summary. Stored in the TYPO3 system configuration.</source></trans-unit>
      <trans-unit id="conf.anthropicModel"><source>Anthropic model: Model id for the summary, e.g. claude-haiku-5-5 (default) or claude-sonnet-5-5 / claude-opus-5-5 (more capable, more expensive).</source></trans-unit>

      <!-- TCA -->
      <trans-unit id="tca.run"><source>Composer report run</source></trans-unit>
      <trans-unit id="tca.collector"><source>Collector</source></trans-unit>
      <trans-unit id="tca.status"><source>Status</source></trans-unit>
      <trans-unit id="tca.total_outdated"><source>Outdated</source></trans-unit>
      <trans-unit id="tca.security_count"><source>Security advisories</source></trans-unit>
      <trans-unit id="tca.report_json"><source>Report (JSON)</source></trans-unit>
      <trans-unit id="tca.ai_summary"><source>AI summary</source></trans-unit>
      <trans-unit id="tca.error_log"><source>Error</source></trans-unit>
      <trans-unit id="tca.triggered_by"><source>Triggered by</source></trans-unit>

      <!-- pxe_hub card (optional) -->
      <trans-unit id="hub.label"><source>Composer Report</source></trans-unit>
      <trans-unit id="hub.noReport"><source>No report yet</source></trans-unit>
      <trans-unit id="hub.lastRunFailed"><source>Last run failed</source></trans-unit>
      <trans-unit id="hub.advisories"><source>%d security advisories</source></trans-unit>
      <trans-unit id="hub.outdated"><source>%d outdated packages</source></trans-unit>
      <trans-unit id="hub.upToDate"><source>Up to date</source></trans-unit>
      <trans-unit id="hub.metricOutdated"><source>Outdated</source></trans-unit>
      <trans-unit id="hub.metricSecurity"><source>Security</source></trans-unit>
      <trans-unit id="hub.metricMajor"><source>Major</source></trans-unit>
      <trans-unit id="hub.openReport"><source>Open report</source></trans-unit>
    </body>
  </file>
